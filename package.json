{
  "name": "meshlink",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "description": "WireGuard 异地组网控制面，运行在 Cloudflare Pages + D1 上",
  "scripts": {
    "dev": "wrangler pages dev",
    "deploy": "wrangler pages deploy ./public --project-name meshlink",
    "db:init": "wrangler d1 execute meshlink --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute meshlink --local --file=schema.sql",
    "test": "python3 -I tests/test_path.py && node --test tests/worker.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
